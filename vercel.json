{
  "version": 2,
  "buildCommand": "yum install -y ImageMagick ghostscript liblcms2 2>/dev/null; npm install && npx next build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "regions": ["bom1"],
  "functions": {
    "src/app/api/process/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/remove-bg/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/check-limits/route.ts": {
      "maxDuration": 10,
      "memory": 512
    }
  }
}
