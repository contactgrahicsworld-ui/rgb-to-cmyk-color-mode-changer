{
  "version": 2,
  "buildCommand": "bun run build",
  "installCommand": "bun install",
  "framework": "nextjs",
  "regions": ["bom1"],
  "functions": {
    "src/app/api/process/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/remove-bg/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/check-limits/route.ts": {
      "maxDuration": 10,
      "memory": 512
    },
    "src/app/api/inspect/route.ts": {
      "maxDuration": 10,
      "memory": 512
    }
  }
}
